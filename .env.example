# Copy this file to `.env` and edit locally. Never commit the real `.env`.
#
# LLM_PROVIDER controls which LLMClient implementation is used.
#   mock      -> fully offline, deterministic, no API key required (DEFAULT).
#   anthropic -> calls the real Anthropic Messages API. Requires
#                ANTHROPIC_API_KEY below.
LLM_PROVIDER=mock

# Only required when LLM_PROVIDER=anthropic. Leave blank otherwise.
# NEVER put a real key in this file (.env.example is committed to git).
ANTHROPIC_API_KEY=

# Optional: override the Anthropic model used when LLM_PROVIDER=anthropic.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: cap output tokens for Anthropic calls.
LLM_MAX_TOKENS=1500

# Optional: fixes the "today" used for the 90-day account-health ticket
# window, for reproducibility. Defaults to a value matching the supplied
# dataset's date range if unset.
REFERENCE_DATE=2026-05-22T00:00:00Z

# Optional: python logging level for structured operational logs.
LOG_LEVEL=INFO
